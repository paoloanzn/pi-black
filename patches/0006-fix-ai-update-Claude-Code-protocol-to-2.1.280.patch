-/** Portable XXH64 used by Claude Code's native request serializer. */
-export function xxHash64(bytes: Uint8Array, seed = 0n): bigint {
-	let offset = 0;
-	let hash: bigint;
-
-	if (bytes.length >= 32) {
-		let v1 = (seed + PRIME64_1 + PRIME64_2) & MASK_64;
-		let v2 = (seed + PRIME64_2) & MASK_64;
-		let v3 = seed & MASK_64;
